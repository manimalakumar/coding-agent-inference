    {
      "run_id": "LC-TIMEOUT-001-dc26d992137f",
      "question": "Does a submitted patch preserve the actual configured client values?",
      "requests": [
        1,
        2,
        20,
        22
      ],
      "learning": "Constructor success alone does not establish preservation of values on the underlying clients. Read file-policy and post-run diagnostic evidence without promoting diagnostics to a successful attempt."
    },
    {
      "run_id": "annotated-tools-minimax-attempt-001/LC-ANNOTATED-TOOLS-001__CFC988s",
      "question": "Can an editing failure prevent acceptance tests from collecting?",
      "requests": [
        1,
        10,
        15,
        25
      ],
      "learning": "A destructive replacement can turn a local edit into an import/collection failure. Small edits and a Git-free restore resource address recoverability; their benefit still requires separate experiments."
    },
    {
      "run_id": "annotated-tools-focused-editing-minimax-attempt-001/LC-ANNOTATED-TOOLS-001__UEiZNLt",
      "question": "Why can an accepted patch retain an unsuccessful historical verdict?",
      "requests": [
        1,
        14,
        23,
        30
      ],
      "learning": "This older attempt accepted the patch but failed its submission protocol. Its historical task verdict stays unsuccessful even though the newer policy evaluates captured workspaces independently of submission."
    },
    {
      "run_id": "annotated-tools-workspace-v2-minimax-attempt-001/LC-ANNOTATED-TOOLS-001__4SxgJND",
      "question": "What does one end-to-end successful attempt establish?",
      "requests": [
        1,
        10,
        20,
        21
      ],
      "learning": "A passing attempt demonstrates that the full workflow can complete. It does not establish a population success rate or show that a particular policy change caused the success."
    },
    {
      "run_id": "responses-usage-minimax-attempt-001/LC-RESPONSES-USAGE-001__vsykNXt",
      "question": "How do regression, existing tests and trusted acceptance complement one another?",
      "requests": [
        1,
        16,
        28,
        30
      ],
      "learning": "Development regression tests, unchanged existing tests and private acceptance checks answer different questions. A single successful task does not establish cross-task reliability."
    },
    {
      "run_id": "chroma-none-workspace-v1-minimax-attempt-002/LC-CHROMA-NONE-001__93XXRpA",
      "question": "Can development checks pass while trusted acceptance still rejects a partial fix?",
      "requests": [
        1,
        11,
        20,
        30
      ],
      "learning": "Passing development checks can miss a behavior covered by trusted acceptance. Read the actual failing assertions before interpreting a partial fix as success."
    }
  ],
